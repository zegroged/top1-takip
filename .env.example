# Fayans ortam değişkenleri şablonu. Kopyala:  cp .env.example .env
NODE_ENV=development

# --- Zorunlu çekirdek ---
DATABASE_URL="postgresql://fayans:fayans_dev_pw@localhost:5432/fayans?schema=public"
# Oturum çerezlerini imzalamak için. En az 16 karakter.
# Üret:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_SECRET=""

# --- Domain ---
NEXT_PUBLIC_ROOT_DOMAIN="localhost"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- İlk admin (sadece hiç admin yoksa /admin/giris üzerinden kurulum içindir) ---
# Bu değerler zorunlu değil; ilk admin paneldeki kurulum ekranından da oluşturulabilir.
ADMIN_USERNAME=""
ADMIN_PASSWORD=""
